    {
      "id": "r4-interface-001",
      "priority": "P1",
      "title": "Gateway document policy disables the microphone required by the default realtime audio flow",
      "scopes": [
        "gateway-core",
        "web-ux"
      ],
      "file": "src/gateway/server.ts",
      "startLine": 23,
      "endLine": 23,
      "trigger": "Open the gateway-served UI in a browser that enforces microphone Permissions Policy, on HTTPS or trusted loopback, select an eligible loaded idle thread, retain the default audio modality and activate the realtime start control.",
      "impact": "The document is served with microphone=(), so browser microphone capture is forbidden regardless of the user granting permission. RealtimeMedia.offer() requires getUserMedia before thread/realtime/start is sent. Thus the advertised audio flow cannot start for affected browsers even in an otherwise valid secure context; the existing capability check can still enable the control because it checks API presence and secure context only.",
      "evidence": [
        "src/gateway/server.ts:20-24 installs permissions-policy camera=(), microphone=(), geolocation=() on the real HTTP response.",
        "web/components/RealtimePanel.tsx:79-87 awaits RealtimeMedia.offer() for audio before constructing the native realtime start mutation.",
        "web/lib/realtime-media.ts:12-22 accepts secure contexts with media APIs and then awaits navigator.mediaDevices.getUserMedia({audio:...,video:false}).",
        "The real loopback HTTP reproduction returned status 200, text/html; charset=utf-8, an application root element, and permissions-policy camera=(), microphone=(), geolocation=().",
        "The existing realtime browser-unit fixture supplies fake media APIs in jsdom; that does not evaluate the actual GatewayServer document policy."
      ],
      "reproduction": {
        "command": "node node_modules/vitest/vitest.mjs run --config .work/round4/interface-repro.config.ts",
        "test": ".work/round4/interface-microphone.test.ts",
        "configuration": ".work/round4/interface-repro.config.ts",
        "observation": ".work/round4/interface-microphone-observation.json",
        "result": "1 file, 1 test passed; the assertion confirms the blocking policy is present, not that the audio feature works.",
        "observed": {
          "observedAt": "2026-10-25T07:45:51.449Z",
          "transport": "real loopback HTTP GatewayServer, local fake worker only",
          "status": 200,
          "contentType": "text/html; charset=utf-8",
          "permissionsPolicy": "camera=(), microphone=(), geolocation=()",
          "documentHasRoot": true
        },
        "limits": "Real local HTTP stack and HTML response; FakeWorker only. No real microphone or browser permission request was performed. Browser blocking follows from the response policy and required getUserMedia call."
      },
      "recommendation": "Permit same-origin microphone use on the app document, retaining the unrelated restrictions, and cover the actual document response policy alongside the audio startup flow."
    }
  ],
