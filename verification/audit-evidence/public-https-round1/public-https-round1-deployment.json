  "findings": [
    {
      "id": "PUBLIC-R1-DEPLOY-RELEASE-DURABILITY",
      "priority": "P1",
      "title": "Release publication can commit before nested entries and final executable modes are durable",
      "file": "deploy/safe_fs.py",
      "lineStart": 180,
      "lineEnd": 183,
      "relatedLocations": [
        {
          "file": "deploy/safe_fs.py",
          "lineStart": 208,
          "lineEnd": 212
        },
        {
          "file": "deploy/build.py",
          "lineStart": 197,
          "lineEnd": 199
        }
      ],
      "trigger": "A host power loss occurs after a newly exported nested release has been renamed, its manifest published and activation committed, but before the filesystem independently flushes unsynced nested directories or metadata changes.",
      "impact": "snapshot fsyncs file data before chmod and only syncs the top export directory. Nested directory entries and the final executable modes have no guaranteed persistence. publish_release then syncs only the releases parent before publishing the durable manifest. A reboot can therefore leave a committed manifest/current pointer naming an incomplete or incorrectly permissioned release; integrity or process start fails and candidate recovery cannot rely on the previously verified tree.",
      "recommendation": "Before publishing the release name or manifest, durably flush every copied regular file after its final metadata changes and every nested directory bottom-up, including parents containing symlinks. Use a shared no-follow durability helper consistent with control_update durable_tree. Preserve the rename/parent-sync/manifest ordering, and add a narrow ordering regression covering nested files and executable modes.",
      "evidence": "Source inspection of the complete snapshot and publish_release paths; control_update already has an explicit bottom-up durable_tree operation for the analogous boundary. Parent reviewer independently confirmed the finding. No claim of physical power-failure reproduction."
    }
  ],
