    {
      "id": "R9-WEB-002",
      "priority": 3,
      "severity": "P3",
      "title": "Contain malformed or interrupted RPC requests in the QA fixture",
      "file": "web/tests/preview-server.mjs",
      "line": 15,
      "endLine": 17,
      "scope": "Loopback-only manual QA helper robustness; not an exposed production gateway issue.",
      "body": "The async http.createServer request callback performs body iteration and JSON.parse before the only try/catch, which wraps static-file serving later. An empty/malformed body throws in JSON.parse, JSON null throws at destructuring, and an interrupted body can reject the iterator. The HTTP event emitter does not consume the rejected callback promise, so the normal Node unhandled-rejection behavior can terminate the whole manual QA server instead of returning a bounded error for that request.",
      "proof": [
        {
          "file": "web/tests/preview-server.mjs",
          "line": 13,
          "detail": "Async request listener has no enclosing rejection handler."
        },
        {
          "file": "web/tests/preview-server.mjs",
          "line": 16,
          "detail": "The request-body async iterator is outside error containment."
        },
