  "findings": [
    {
      "id": "V233-GATEWAY-1",
      "priority": "P2",
      "title": "Emergency recovery is starved by the ordinary HTTP request budget",
      "locations": [
        "src/gateway/server.ts:188",
        "src/core/contracts.ts:23",
        "src/gateway/worker-client.ts:139"
      ],
      "trigger": "48 ordinary reads remain awaiting worker confirmation; emergency system/recover uses the same exhausted admission pool before method parsing.",
      "impact": "Authenticated force recovery returns capacity/not_sent without reaching the manager reserved emergency slot; closing the browser does not free outstanding backend reservations, so the recovery control stays unavailable for up to the 350-second worker deadline.",
      "evidence": ".work/v233-audit-1/gateway-saturation-result.json",
      "fix": "Provide bounded separately authenticated emergency admission from HTTP through response/receipt capacity, retaining CSRF, current protocol, explicit confirmation and original receipt identity; verify no other RPC can use it."
    },
    {
      "id": "V233-GATEWAY-2",
      "priority": "P2",
      "title": "Valid generated images exceed browser event and cumulative history budgets without a recoverable media reference",
      "locations": [
        "src/gateway/server.ts:134",
        "src/core/contracts.ts:25",
        "src/runtime/history.ts:56",
        "web/lib/history.ts:3"
      ],
      "trigger": "A completed imageGeneration.result Base64 payload for a roughly 3MiB or larger image, or accumulated inline images in one history.",
      "impact": "Event causes 1013 disconnect and history cannot hydrate the result; normal reconnect does not recover generated files outside the registered attachment index.",
      "evidence": "Runtime auditor cross-review of history.ts and attachments.ts, plus prior pinned native app-server inline-image contract. No commercial image inference executed.",
      "fix": "Externalize generated media to bounded authenticated chunk reads with lightweight stable history references; do not only raise WS limits."
    }
  ],
