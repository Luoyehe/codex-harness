  "findings": [
    {
      "id": "organization-completion-synchronization",
      "confirmed": true,
      "files": [
        "tests/runtime/organization-native.test.ts"
      ],
      "evidence": "The initial real CLI trace returned turn/start inProgress, then thread/read idle before a subsequent includeTurns read returned active. The old test treated the idle metadata read as completion. Four further executions retaining all old assertions had two passes and two thread_busy failures during organization import.",
      "fix": "Collect runtime events before conversation creation, await turn/completed for the exact thread and initial turn, and require status completed. Preserve the original idle check, organization persistence, root separation, history, one local provider call and process cleanup assertions.",
      "contract": "reference/PROTOCOL-CONTRACT.md states that turn completion is determined by turn/completed; thread and turn statuses are distinct."
    },
    {
      "id": "known-turn-idle-admission",
      "confirmed": true,
      "files": [
        "src/runtime/service.ts",
        "tests/runtime/service.test.ts"
      ],
      "evidence": "With a complete history traversal and an accepted inProgress turn, either an idle metadata response or an idle status notification allowed a second turn/start to dispatch and resolve. Both deterministic regression cases failed against the original runtime in run-z10bCq; no native backend was involved in these two proofs.",
      "fix": "Treat a known uncompleted turn ID as activity independently of thread status in status reporting, admission, organization import, configuration changes, workflow mode guards and fatal outcome tracking. Matching turn/completed retains its existing release behavior; unknown flags are not cleared.",
      "regressionCoverage": [
        "idle metadata cannot admit a second turn",
        "idle notification cannot admit a second turn",
        "organization import and memory configuration remain blocked",
        "a completion for another turn does not release ownership",
        "matching completion permits the next turn",
        "an unknown outcome remains blocked after metadata and completion",
        "a fresh runtime epoch requires history and then permits recovery"
      ]
    }
  ],
  "causalBoundary": "The original full-run error has only the common NativeRpc.receive stack, so its exact originating RPC was not recovered. In the instrumented original native tests, thread/turns/list returned -32601 list_turns is not supported yet and the existing legacy fallback handled it. The original uncaught list_turns symptom was not independently reproduced. The proven synchronization and admission defects are fixed; a new complete full run remains required. No broader native error fallback was added.",
