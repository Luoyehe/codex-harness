  "findings": [
    {
      "id": "FULL2-RUNTIME-01",
      "status": "fixed",
      "resolution": "Gateway RPC captures the exact admission-time BrowserConnection before awaiting its body. Late bodies and final writes cannot borrow a replacement owner; already-accepted receipt replay remains available.",
      "tests": [
        "tests/gateway/http-connection-admission.test.ts",
        "tests/gateway/http.test.ts"
      ]
    },
    {
      "id": "FULL2-RUNTIME-02",
      "status": "fixed",
      "resolution": "Direct POSIX development/isolated native launches use a dedicated controller stop pipe and zero-exit cleanup proof. Linux shares pidfd/subreaper cleanup with standalone jobs. Portable POSIX retains the unreaped leader through group cleanup. Graceful SIGTERM gets at most 1 second before bounded force cleanup; Node never signals a historical PGID after close.",
      "tests": [
        "tests/runtime/posix-native.test.ts",
        "tests/runtime/native.test.ts",
        "tests/runtime/linux-process.test.ts",
        "tests/runtime/defaults-lifecycle.test.ts",
        "tests/runtime/process-native.test.ts"
      ]
    },
    {
      "id": "FULL2-RUNTIME-03",
      "status": "fixed",
      "resolution": "Removed historical numeric-PID fallback kills and post-close absence checks from Windows and native fixtures. Owned ChildProcess close state proves the original controller exit; descendant checks capture OS process creation identity before triggering exit. Fixtures hold natural exit until identities are captured, while preserving the original exit code and natural cleanup scenario.",
      "tests": [
        "tests/runtime/windows-job.test.ts",
        "tests/runtime/windows-process.test.ts",
        "tests/runtime/process-identity.test.ts",
        "tests/runtime/defaults-lifecycle.test.ts",
        "tests/runtime/approval-native.test.ts",
        "tests/runtime/automation-native.test.ts",
        "tests/runtime/extensions-native.test.ts",
        "tests/runtime/gateway-native.test.ts",
        "tests/runtime/input-native.test.ts",
        "tests/runtime/mcp-native.test.ts",
        "tests/runtime/native-smoke.test.ts",
        "tests/runtime/process-native.test.ts",
        "tests/runtime/terminal-cleanup.test.ts",
        "tests/runtime/workflows-native.test.ts"
      ]
    },
    {
      "id": "FULL2-RUNTIME-04",
      "status": "fixed",
      "resolution": "Runtime README distinguishes 12 MiB native frames/private responses from the shared 4 MiB encoded UTF-8 event limit, and documents dedicated controller descriptors plus portable-platform scope."
    }
  ],
