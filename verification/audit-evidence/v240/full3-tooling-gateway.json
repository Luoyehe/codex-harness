  "findings": [
    {
      "id": "FULL3-CI-01",
      "priority": 2,
      "files": [
        ".github/workflows/affected.yml",
        "scripts/ci-checks.mjs",
        "tests/tooling/ci-checks.test.ts"
      ],
      "description": "The workflow injects inputs.authorization_sha256 || repository HARNESS_RELEASE_AUTHORIZATION_SHA256 on every event, including trusted main pushes. buildCiPlan treats any nonempty injected checksum as mandatory and throws on an old checksum, even when the committed source-bound authorization is valid. A retained prior-release repository variable therefore makes the next main push fail during planning. Restrict repository-variable fallback to PR approval; explicit manual checksums must still fail closed when invalid, while trusted main validates its committed source-bound authorization without stale repository state. Cover actual buildCiPlan and workflow event selection, not only selectCiPlan.",
      "evidence": [
        ".work/v240/full3-ci-variable-probe.log"
      ],
      "reproduction": "Actual buildCiPlan against a disposable committed Git fixture: valid source-bound main push succeeds with no variable; same source/event fails Authorization checksum mismatch with a synthetic stale checksum. No GitHub repository variable was read or changed; the current deployed variable value is not asserted."
    }
  ],
