    "observation": "Linux full CI assertion expecting file.txt worktree M failed. That assertion is retained; it was not an invalid test expectation."
  },
  "finding": {
    "priority": "P2",
    "path": "deploy/workspace_git_view.py",
    "originalLine": 66,
    "trigger": "A same-size working-tree edit has cached stat fields matching the Git index, while the original index timestamp marks the entry racy. Creating the isolated index copy at a later time removes the original racy timestamp relationship.",
    "impact": "Real modified files can be omitted from workspace Git status/diff. The private view treats a cached stat match as clean instead of comparing the blob content.",
    "cause": "write_bytes assigned a new mtime to the copied index. The content bytes alone are not enough to preserve Git racy-clean semantics.",
    "evidence": [
      "Three unmodified-source Linux Git 2.43.0 probes: original repository status M; product private view empty; resetting only the private index timestamp restores M; original index bytes unchanged.",
      "Deterministic new real-Git regression failed on the original product and passed after preserving the timestamp."
    ]
  },
  "implementation": {
    "files": [
      {
        "path": "deploy/workspace_git_view.py",
        "sha256": "c304778fedbd55ca7c71130eec71df5d79729c54f5a0b1db5885ac9bc93edaf8",
        "previousSha256": "97e02216521e0067a18ddc75d8f7d7932b50e4051278edc0b01b04aca5be23c2"
      },
      {
        "path": "tests/deploy/test_workspace.py",
        "sha256": "6072fc155964d94cb797baaca60b8d7863c2ffa83e34325d55853738eab1cdae",
        "previousSha256": "365b0f8ef95c5179d143f1211ffb11f0af90c42ee44ffe83082ba4d49edf94a0"
      }
    ],
    "behavior": "Read index bytes and stable stat together from the same O_NOFOLLOW descriptor using existing read_file validation. Copy the exact mtime into each private index/sharedindex file. Keep the byte-returning read_index API for worktree callers.",
    "preservedSecurity": [
      "No repository config, callbacks, credential helpers, hooks, fsmonitor, filters or external diff commands are copied/enabled.",
      "The existing hostile fsmonitor, diff.external, textconv and clean-filter marker assertions are unchanged and passed.",
      "Existing descriptor/path constraints, byte/entry/time limits, fixed argv/environment, original index immutability and Git descendant cleanup remain unchanged."
    ],
    "testDesign": "The new test uses an explicit SHA1/v2 one-entry fixture index, keeps its original blob ID, makes cached ctime/mtime match the equal-size edited file, recomputes the required Git index checksum, and sets source index mtime to the matching file time. Native Git must report M, workspace status/diff must agree, and original index bytes/mtime must remain unchanged. This avoids clock/scheduler sleeps in the regression.",
    "testHashBoundary": "The SHA1 operation is only the required checksum of a disposable Git SHA1-format index fixture, not password verification or a new production security primitive. Any future actual scanner annotation still requires its own dataflow review."
  },
