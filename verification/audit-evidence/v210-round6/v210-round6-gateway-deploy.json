  "findings": [
    {
      "id": "GDEP-R6-001",
      "priority": 2,
      "severity": "P2",
      "title": "在观察到 EOF 时启动独立的原生进程清理截止时间",
      "file": "deploy/native_launcher.py",
      "startLine": 95,
      "endLine": 107,
      "body": "streaming 桥只在 input_ended 且 pending 已排空后设置 ended_at。若原生 CLI 持续存活但停止读取 stdin，桥内已积压的数据无法排空；即使已实际读到上游 EOF，ended_at 仍为 None，循环便永远到不了清理超时。NativeRpc.stop 的 launcher 分支仅 end stdin 并等待 6 秒，所以这一正常关闭路径会报告 cleanup unknown 并留下原生进程等待后续外部终止，而不是执行有界清理。",
      "trigger": "原生 CLI 不再读取 stdin，桥仍有待发数据，随后上游关闭输入。64 KiB 待发数据就能在尚未达到 8 MiB 输入容量的情况下实际观察 EOF 并触发此问题。",
      "impact": "依赖 EOF 的运行时关闭无法回收仍在运行的 CLI 及其后代，6 秒后进入 cleanup unknown；只有额外服务信号、原生进程自行退出或恢复读取才能解除。",
      "recommendation": "EOF 一经观察就启动独立且不被排空逻辑延后的终止截止时间，允许在有限宽限期内排空数据，期满后进入已有 clean_children 流程。新增 CLI 不读取输入、已有待发字节且上游 EOF 的组合回归。",
      "evidence": {
        "relatedCurrentSource": "src/runtime/native.ts:175-181",
        "existingCoverageGap": "tests/deploy/test_native_shutdown.py:62-64,85-86 的 EOF 场景没有先写输入；tests/deploy/test_deployment.py:735-747 的背压场景最终会读取输入。",
        "reproductionArtifact": ".work/v210-round6-native-eof-repro.json",
        "reproductionKind": "从当前源码 AST 抽取 supervise，注入确定性的 selector、存活但不读取的子进程和时钟；最多 100 次轮询；不启动 OS 子进程或测试套件。",
        "result": "空缓冲 EOF 在 2.1 秒进入清理并返回 0；64 KiB 待发字节在 0.2 秒已观察 EOF，10.1 秒后仍未自行清理，只有复现器限步异常才进入 finally。",
        "sourceSha256": "b3660ae60a03a1880640fe7fa2151de229add4aa8a7680611ae59e6f06d1edff"
      }
    }
  ],
