  "findings": [
    {
      "id": "V210-R2-WEB-001",
      "priority": "P2",
      "severity": "P2",
      "title": "模型发现成功后被父级刷新卸载，发现的模型无法继续确认应用",
      "file": "web/components/ModelCatalog.tsx",
      "start": 53,
      "end": 53,
      "evidence": [
        "ModelCatalog.tsx:53 将 onApplied 直接作为 useExtensionAction 的每次成功变更回调；发现按钮在 78-80 行通过 action.run 调用 system/models/refresh。",
        "useWorkflow.ts:63-67 在返回成功结果前调用 onChanged；ExtensionControls.tsx:11-16 将其转发给 onApplied。",
        "ProviderSettings.tsx:350-374 只在 resource.data 存在时挂载 ModelCatalog，onApplied 在 368-370 行调用 resource.refresh()。",
        "useResource.ts:19-20、41-43 在刷新后的首个 render 隐藏旧数据，使 ModelCatalog 卸载；发现回调在 91-93 行设置的 rows/status 随之丢失。重新读取供应商得到相同 revision 仍会重挂载。",
        "现有 provider.test.tsx:54 的发现/能力确认测试单独挂载 ModelCatalog；组合 ProviderSettings 测试只检查原生目录刷新时默认模型字段草稿保留，因此未覆盖第三方模型发现结果的生命周期。"
      ],
      "reproduction": {
        "type": "isolated_offline_component_composition",
        "helper": ".work/v210-round2-provider-discovery.test.tsx",
        "config": ".work/v210-round2-web-repro.config.mjs",
        "command": "node node_modules/vitest/vitest.mjs run --config .work/v210-round2-web-repro.config.mjs",
        "inputs": "挂载真实 ProviderSettings；system/provider/read 始终返回 revision=r1、kind=responses、models=[]；发现 RPC 返回 discovered-test-model 和 requiresConfirmation=true/applied=false。",
        "observed": "发现仅发送一次；父级出现第二次 provider read；读取完成后 discovered-test-model 复选框不存在。单项测试在 queryByRole(...).not.toBeNull() 处按预期失败。",
        "expected": "仅发现模型时应保留新发现的 rows，让用户核对能力并明确确认应用。",
        "tests": 1,
        "failed": 1,
        "exitCode": 1,
        "network": false,
        "actualRuntimeOrModel": false
      },
      "impact": "Responses 等第三方供应商的正常“发现模型→选择能力→确认应用”流程中断。重新点击发现重复得到相同结果，用户只能绕过发现自行手工填写模型。",
      "recommendation": "将发现与应用成功后的父级配置刷新分开；发现只更新本组件的待确认目录，确认应用成功才刷新供应商与模型资源。补充真实 ProviderSettings 组合回归，而不只测试独立 ModelCatalog。",
      "confidence": "high",
      "fixed": false
    }
  ],
