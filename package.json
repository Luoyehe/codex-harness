{
  "name": "codex-harness",
  "private": true,
  "version": "1.0.0",
  "description": "Self-hosted WebUI for the open-source Codex harness (codex app-server), with provider presets for OpenAI and Zhipu Coding Plan.",
  "license": "MIT",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Luoyehe/codex-harness.git"
  },
  "bugs": {
    "url": "https://github.com/Luoyehe/codex-harness/issues"
  },
  "keywords": ["codex", "openai", "webui", "self-hosted", "agent", "zhipu", "glm"],
  "scripts": {
    "dev": "concurrently -n gateway,web -c blue,magenta \"pnpm --filter @codex-harness/gateway dev\" \"pnpm --filter @codex-harness/web dev\"",
    "build": "pnpm --filter @codex-harness/web build && pnpm --filter @codex-harness/gateway build",
    "test": "pnpm --filter @codex-harness/gateway test",
    "typecheck": "pnpm -r typecheck && pnpm --filter @codex-harness/gateway exec tsc -p ../../protocol/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
