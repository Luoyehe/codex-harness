# 智谱个人版 Coding Plan（ZAI provider）模型源配置模板
# 官方文档: https://docs.bigmodel.cn/cn/coding-plan/tool/codex
#
# 使用方法：
#   1. mkdir -p ~/.codex
#   2. cp config.toml.example ~/.codex/config.toml   （本目录的 models.json 也一并拷过去）
#   3. 在服务的 600 权限 EnvironmentFile 中设置 Z_AI_API_KEY
#      （Coding Plan 专用 Key，与平台普通 Key 不通用；不要写入此文件）
#   已装 coding-helper（chelper）的机器也可直接: chelper auth reload codex
#
# MCP 服务器（联网搜索/网页阅读/仓库阅读/视觉）请再运行同目录 setup.sh。

model_provider = "ZAI"
model = "glm-5.3"
model_reasoning_effort = "max"
model_catalog_json = "~/.codex/models.json"

[model_providers.ZAI]
name = "ZAI"
base_url = "https://open.bigmodel.cn/api/v1"
env_key = "Z_AI_API_KEY"
wire_api = "responses"

# ---------------------------------------------------------------------------
# 以下为 MCP 必需的 feature 开关：codex 0.149 的新 MCP 客户端，
# 不开启则 MCP 工具永远不会注入。setup.sh 也会确保它存在。
[features]
mcp_2026_07_28 = true
